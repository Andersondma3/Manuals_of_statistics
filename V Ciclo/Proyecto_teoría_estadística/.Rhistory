# ---------------------------------------------------------
# Función genérica de potencia (misma lógica que tu código,
# pero parametrizada para reutilizar con distintos r / n_sim)
# ---------------------------------------------------------
simular_potencia <- function(r,
med = 3.59,
ef_herramienta = c("I" = 0, "J" = -0.157),
ef_problem = c(0, -0.416, -0.127, -0.073),
ef_g = c(0, 0.272, -0.280, -0.027, 0.025),
sd_est = 0.16,
sd_res = 0.49,
bloque_base = c("I", "I", "J", "J"),
n_sim = 1000,
alpha = 0.05,
seed = NULL) {
stopifnot(length(ef_g) == length(r))  # cada grupo necesita su efecto fijo
if (!is.null(seed)) set.seed(seed)
n_estudiantes = sum(r)
n_grupos = length(r)
grupo_expandido    = rep(factor(rep(2:(n_grupos + 1), times = r)), each = 4)
problema_expandido = factor(rep(1:4, times = n_estudiantes))
est = rep(1:n_estudiantes, each = 4)
# Diseño en bloques (2 I y 2 J por estudiante, orden aleatorio)
herramientas_lista  = replicate(n_estudiantes, sample(bloque_base), simplify = FALSE)
herramientas_vector = unlist(herramientas_lista)
herramienta = factor(herramientas_vector, levels = c("I", "J"))
p_herramienta = rep(NA_real_, n_sim)
sdest = rep(NA_real_, n_sim)
sdres = rep(NA_real_, n_sim)
for (i in 1:n_sim) {
ef_est  = rep(rnorm(n_estudiantes, 0, sd_est), each = 4)
epsilon = rnorm(length(grupo_expandido), 0, sd_res)
y = med +
ef_herramienta[herramienta] +
ef_problem[as.numeric(problema_expandido)] +
ef_g[as.numeric(grupo_expandido)] +
ef_est +
epsilon
mod = tryCatch(
suppressMessages(suppressWarnings(
lmer(y ~ herramienta + problema_expandido + grupo_expandido + (1 | est))
)),
error = function(e) NULL
)
if (is.null(mod)) next
vc = as.data.frame(VarCorr(mod))
sdest[i] = vc[1, 5]
sdres[i] = vc[2, 5]
p_herramienta[i] = tryCatch(drop1(mod, test = "Chisq")[2, 4],
error = function(e) NA_real_)
}
list(
n_total    = n_estudiantes,
r          = r,
potencia   = mean(p_herramienta < alpha, na.rm = TRUE),
sd_est_hat = mean(sdest, na.rm = TRUE),
sd_res_hat = mean(sdres, na.rm = TRUE),
p_valores  = p_herramienta
)
}
# ---------------------------------------------------------
# Escalador: mantiene proporciones de r_base para un N nuevo
# ---------------------------------------------------------
escalar_r <- function(r_base, n_total_nuevo) {
prop = r_base / sum(r_base)
r_nuevo = round(prop * n_total_nuevo)
diferencia = n_total_nuevo - sum(r_nuevo)
if (diferencia != 0) {
idx = order(-prop)[seq_len(abs(diferencia))]
r_nuevo[idx] = r_nuevo[idx] + sign(diferencia)
}
r_nuevo[r_nuevo < 1] = 1
r_nuevo
}
r_base  = c(4, 12, 14, 3, 2)          # distribución original (N = 35)
tamanos = seq(20, 100, by = 10)       # tamaños totales a explorar
resultados = data.frame(n_total = integer(), potencia = numeric())
for (n in tamanos) {
r_n = escalar_r(r_base, n)
res = simular_potencia(r_n, n_sim = 300, seed = 123)  # n_sim bajo para explorar rápido
resultados = rbind(resultados, data.frame(n_total = res$n_total, potencia = res$potencia))
cat("N =", res$n_total, "-> potencia =", round(res$potencia, 3), "\n")
}
# ---- Curva de potencia ----
plot(resultados$n_total, resultados$potencia,
type = "b", pch = 19, col = "steelblue", lwd = 2,
xlab = "Tamaño total de muestra (N)",
ylab = "Potencia estimada",
ylim = c(0, 1),
main = "Curva de potencia para el efecto de Herramienta")
abline(h = 0.8, lty = 2, col = "red")

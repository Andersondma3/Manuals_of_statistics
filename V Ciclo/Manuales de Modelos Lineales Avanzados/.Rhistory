dt=mod.trat$coef
d0 = c(1,0,0,0)
d200 = c(1,1,0,0)
d400 = c(1,0,1,0)
d800 = c(1,0,0,1)
d0.200 = d0-d200
d0.400 = d0-d400
d0.800 = d0-d800
d200.400 = d200-d400
d200.800 = d200-d800
d400.800 = d400-d800
h = cbind(d0.200, d0.400, d0.800, d200.400, d200.800, d400.800 )
eta=t(h)%*%dt
or=exp(abs(eta))
colnames(or)="OR"
round(or,2)

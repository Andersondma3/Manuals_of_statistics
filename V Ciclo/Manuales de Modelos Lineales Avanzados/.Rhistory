mod0=lm(ind_mg_dry~order,data = dm)
qqPlot(mod0$residuals)
mod0=lm(ind_mg_dry~order,data = dm)
qqPlot(mod0$residuals)
mod0=lm(ind_mg_dry~order,data = dm)
qqPlot(mod0$residuals)
invisible(qqPlot(mod0$residuals))
mod0=lm(ind_mg_dry~order,data = dm)
invisible(qqPlot(mod0$residuals))
mod0=lm(ind_mg_dry~order,data = dm)
invisible(qqPlot(mod0$residuals))
library(MASS)
boxcox(mod0)
mod1=lm(log(ind_mg_dry)~order,data = dm)
qqPlot(mod1$residuals)
invisible(qqPlot(mod1$residuals))
shapiro.test(mod1$residuals)

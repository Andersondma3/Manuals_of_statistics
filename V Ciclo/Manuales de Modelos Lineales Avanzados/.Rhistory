set.seed(2026) # Consistencia en la simulación
n_clientes <- 1000
# Variables predictoras (Características del cliente)
ingreso_mensual <- round(runif(n_clientes, min = 800, max = 5000), 2) # en USD
tipo_tarjeta <- sample(c("Regular", "Gold", "Black"), size = n_clientes,
replace = TRUE, prob = c(0.6, 0.3, 0.1))
# Exposición (N): Meses que lleva el cliente con la tarjeta activa en el año
meses_activos <- sample(1:12, size = n_clientes, replace = TRUE)
# Definimos el logaritmo de la tasa teórica (lambda) usando parámetros fijos
# Nota cómo influyen el ingreso y la categoría de la tarjeta
log_tasa_teorica <- -2 + 0.0005 * ingreso_mensual +
ifelse(tipo_tarjeta == "Gold", 0.4, 0) +
ifelse(tipo_tarjeta == "Black", 0.8, 0)
# El conteo esperado es: mu = N * exp(log_tasa_teorica)
mu <- meses_activos * exp(log_tasa_teorica)
# Generamos la variable respuesta (Y) usando la distribución Poisson
transacciones_extranjero <- rpois(n_clientes, lambda = mu)
# Consolidamos el dataframe
datos_banca <- data.frame(
id_cliente = 1:n_clientes,
transacciones = transacciones_extranjero,
meses_exposicion = meses_activos,
ingreso = ingreso_mensual,
tarjeta = factor(tipo_tarjeta, levels = c("Regular", "Gold", "Black"))
)
# ==============================================================================
# 2. GUARDAR Y CARGAR EL ARCHIVO .RData
# ==============================================================================
# Guardar el objeto en el directorio de trabajo
save(datos_banca, file = "datos_banca_offset.RData")
View(datos_banca)
View(datos_banca)
mod = glm(transacciones ~ tarjeta + ingreso, family = poisson(link = "log"), offset = log(meses_exposicion), data = datos_banca)
# Resumen estadístico del modelo
summary(modelo_banca)
mod1 = glm(transacciones ~ tarjeta + ingreso, family = poisson(link = "log"), offset = log(meses_exposicion), data = datos_banca)
# Resumen estadístico del modelo
summary(mod1)
summary(mod1)
summary(mod1)
round(mod1$coef,5)
exp(0.00051)
exp(0.41)
contrasts(datos_banca$tarjeta)

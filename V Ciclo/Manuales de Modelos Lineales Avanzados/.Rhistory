library(ggplot2)
set.seed(2026)
n <- 500
omega <- 0.35  # 35% de probabilidad de obtener un cero estructural
lambda <- 4    # Media del componente Poisson
# 1. Simulación del proceso de mezcla
# Generamos una variable Bernoulli (0 o 1) para decidir el origen del dato
es_cero_estructural <- rbinom(n, size = 1, prob = omega)
datos_poisson <- rpois(n, lambda = lambda)
# Si es_cero_estructural es 1, el conteo es 0; si no, viene de la Poisson
contingencias <- ifelse(es_cero_estructural == 1, 0, datos_poisson)
df_zip <- data.frame(Conteos = contingencias)
# 2. Gráfico de Densidad / Histograma
ggplot(df_zip, aes(x = Conteos)) +
# Usamos un histograma de densidad (y = ..density..) adaptado a datos discretos
geom_histogram(aes(y = ..density..), binwidth = 0.5,
fill = "steelblue", color = "white", alpha = 0.8) +
# Línea de densidad suavizada para marcar el perfil de la distribución
geom_density(color = "darkred", size = 1, adjust = 2) +
labs(
title = "Distribucion Poisson Inflada con Ceros (ZIP)",
subtitle = paste0("n = ", n, ", ", omega*100, "% de ceros estructurales y lambda = ", lambda),
x = "Conteo de eventos (Y)",
y = "Densidad de probabilidad"
) +
scale_x_continuous(breaks = 0:max(contingencias)) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 14),
panel.grid.minor = element_blank()
)

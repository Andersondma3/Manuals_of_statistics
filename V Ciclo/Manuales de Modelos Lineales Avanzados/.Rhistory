load("moscas.Rdata")
attach(base)
library(ggplot2)
qplot(trat1,conteo,geom="boxplot",ylab="conteo",xlab="tratamiento")
options(contrasts=c("contr.sum","contr.poly")) # Suma nula
mod1=glm(conteo~trat1,family=poisson,data=base)
contrasts(trat1)
d=mod1$coef
d1=c(d,-sum(d[2:4]))
names(d1)[5] = "trat14"
round(d1,2)
d2=d1[-1]
lambda=exp(d[1]+d2)
names(lambda)=levels(trat1)
round(lambda,2)
fit=predict(mod1,type="response")
means = unique(predict(mod1,type="response"))
names(means) = levels(base$trat1)
# También se puede con
# tapply(fit,trat1,mean)
means
r=residuals(mod1,type="response") # El type response, es una predicción de la media del modelo
#Sin el "response", calcula solo la parte lineal no la media
# Configurar la ventana para ver los 3 gráficos lado a lado
par(mfrow = c(1, 3))
# Valores fijos de log(fit) basados en tu imagen
log_fit <- c(rep(0.3, 3), rep(1.45, 6), rep(2.05, 6), rep(2.23, 6))
# -------------------------------------------------------------------------
# 1. EQUIDISPERSIÓN (Puntos perfectamente alrededor de la línea)
# -------------------------------------------------------------------------
# Definimos desvíos fijos y balanceados para que fuercen la oscilación sobre la línea
desvios_equi <- c(
-0.3, 0.0, 0.3,                 # Para x = 0.3
-0.4, -0.1, 0.2, -0.2, 0.1, 0.4, # Para x = 1.45
-0.5, -0.2, 0.1, -0.1, 0.3, 0.4, # Para x = 2.05
-0.4, -0.2, 0.0, 0.2, 0.3, -0.1  # Para x = 2.23
)
log_r2_equi <- log_fit + desvios_equi
plot(log_r2_equi ~ log_fit, pch = 18, cex = 1.5,
xlim = c(0.2, 2.4), ylim = c(-1, 6),
xlab = expression(log(hat(lambda))), ylab = expression(log(r^2)),
main = "Equidispersión")
abline(0, 1, lwd = 2, col = "red")
# -------------------------------------------------------------------------
# 2. SOBREDISPERSIÓN (Todos los puntos arriba de la línea)
# -------------------------------------------------------------------------
# Sumamos valores positivos altos para desplazar toda la nube hacia arriba
desvios_sobre <- c(
0.8, 1.2, 1.5,
1.0, 1.4, 1.9, 2.3, 2.7, 3.1,
1.2, 1.8, 2.4, 3.0, 3.5, 4.0,
1.5, 2.0, 2.5, 3.1, 3.6, 4.2
)
log_r2_sobre <- log_fit + desvios_sobre
plot(log_r2_sobre ~ log_fit, pch = 18, cex = 1.5,
xlim = c(0.2, 2.4), ylim = c(-1, 6),
xlab = expression(log(hat(lambda))), ylab = expression(log(r^2)),
main = "Sobredispersión")
abline(0, 1, lwd = 2, col = "red")
# -------------------------------------------------------------------------
# 3. SUBDISPERSIÓN (Todos los puntos abajo de la línea)
# -------------------------------------------------------------------------
# Restamos valores para arrastrar absolutamente todos los puntos debajo de la línea
desvios_sub <- c(
-0.8, -1.0, -1.2,
-0.8, -1.0, -1.1, -1.3, -1.4, -1.5,
-0.9, -1.1, -1.3, -1.4, -1.6, -1.8,
-1.0, -1.2, -1.3, -1.5, -1.7, -1.9
)
log_r2_sub <- log_fit + desvios_sub
plot(log_r2_sub ~ log_fit, pch = 18, cex = 1.5,
xlim = c(0.2, 2.4), ylim = c(-1, 6),
xlab = expression(log(hat(lambda))), ylab = expression(log(r^2)),
main = "Subdispersión")
abline(0, 1, lwd = 2, col = "red")
# Restaurar ventana gráfica
par(mfrow = c(1, 1))
n = nrow(base)#número de observaciones
p = length(mod1$coef)#Número de coef
phi=sum(residuals(mod1,type="pearson")^2)/(n-p)
round(phi,1)

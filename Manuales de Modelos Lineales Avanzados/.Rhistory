)
library(ggplot2)
library(dplyr)
set.seed(123)
temperaturas <- c(200, 225, 250, 275)
lotes <- c(1, 2, 3)
n_muestras <- 4
df_simulado_factor <- expand.grid(
temp = temperaturas,
lote = as.factor(lotes),
replica = 1:n_muestras
) %>%
mutate(
# Convertimos explícitamente a factor para el gráfico
temp_factor = as.factor(temp),
# La simulación sigue una lógica de efectos por nivel
res = 25 + (as.numeric(lote) * 2) + (as.numeric(temp_factor) * 2.5) + rnorm(n(), 0, 1.5)
)
# Gráfico 1: Puntos con Temperatura como Factor en el eje X
ggplot(df_simulado_factor, aes(x = temp_factor, y = res, color = lote)) +
geom_point(size = 2.25, alpha = 0.8, position = position_jitter(width = 0.1)) +
facet_wrap(~ lote) +
scale_color_manual(values = c("#E41A1C", "#377EB8", "#4DAF4A")) +
labs(
title = "Temperatura como Variable Categórica (Factor)",
x = "Niveles de Temperatura",
y = "Resistencia"
) +
theme_bw() +
theme(legend.position = "none", plot.title = element_text(hjust = 0.5, face = "bold"))

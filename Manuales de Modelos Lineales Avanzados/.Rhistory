# 1. Simulación (Mantenemos tu lógica exacta)
set.seed(2026)
temp_cont <- seq(200, 275, length.out = 50)
metodos <- c("Metodo 1", "Metodo 2", "Metodo 3")
lotes_por_metodo <- 1:4
df_pendientes <- expand.grid(
temp = temp_cont,
metodo = metodos,
lote_id = lotes_por_metodo
) %>%
group_by(metodo, lote_id) %>%
mutate(
lote_unico = as.factor(paste(metodo, "Lote", lote_id)),
beta_base = 0.20,
beta_lote = rnorm(1, mean = 0, sd = 0.15),
beta_final = beta_base + beta_lote,
efecto_metodo = case_when(
metodo == "Metodo 1" ~ 10,
metodo == "Metodo 2" ~ 30,
metodo == "Metodo 3" ~ 50
),
res = efecto_metodo + (beta_final * (temp - 200))
) %>%
ungroup()
# 2. SOLUCIÓN AL ERROR: Crear un dataframe de medias INDEPENDIENTE
# Esto garantiza que las líneas negras sean perfectamente paralelas (Pendiente = 0.20)
df_medias_p <- expand.grid(
temp = temp_cont,
metodo = metodos
) %>%
mutate(
efecto_metodo = case_when(
metodo == "Metodo 1" ~ 10,
metodo == "Metodo 2" ~ 30,
metodo == "Metodo 3" ~ 50
),
res_media = efecto_metodo + (0.20 * (temp - 200)) # Pendiente fija
)
# 3. Gráfico Único
ggplot() +
# Líneas de los lotes (Divergentes)
geom_line(data = df_pendientes,
aes(x = temp, y = res, color = metodo, group = lote_unico),
size = 0.7, alpha = 0.4) +
# Líneas de la MEDIA (Negras y PARALELAS)
geom_line(data = df_medias_p,
aes(x = temp, y = res_media, group = metodo),
color = "black", size = 1.2) +
scale_color_manual(values = c("Metodo 1" = "#E41A1C",
"Metodo 2" = "#377EB8",
"Metodo 3" = "#4DAF4A")) +
labs(
title = "Interacción Lote × Método",
x = "Temperatura",
y = "Resistencia",
color = "Método"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5),
legend.position = "bottom"
)
# 1. Simulación de datos: Interacción Lote x Temperatura
set.seed(2026)
temp_cont <- seq(200, 275, length.out = 50)
metodos <- c("Metodo 1", "Metodo 2", "Metodo 3")
lotes_por_metodo <- 1:4
df_pendientes <- expand.grid(
temp = temp_cont,
metodo = metodos,
lote_id = lotes_por_metodo
) %>%
group_by(metodo, lote_id) %>%
mutate(
lote_unico = as.factor(paste(metodo, "Lote", lote_id)),
# 1. NO INTERACCIÓN MÉTODO x TEMP: Pendiente base igual para todos
beta_base = 0.20,
# 2. INTERACCIÓN LOTE x TEMP: Variación en pendiente (beta)
# Aumentamos el sd para que se note la diferencia de inclinación
beta_lote = rnorm(1, mean = 0, sd = 0.15),
beta_final = beta_base + beta_lote,
# Efecto del Método (Intercepto fijo por método)
efecto_metodo = case_when(
metodo == "Metodo 1" ~ 10,
metodo == "Metodo 2" ~ 10,
metodo == "Metodo 3" ~ 10
),
# Resultado lineal: Todos los lotes de un método comparten el mismo intercepto
# pero difieren en su pendiente (beta_final)
res = efecto_metodo + (beta_final * (temp - 200))
) %>%
ungroup()
# 2. Cálculo de la línea de la media por método
df_medias_p <- df_pendientes %>%
group_by(metodo, temp) %>%
summarise(res_media = mean(res), .groups = 'drop')
# 3. Gráfico Único
ggplot() +  # Líneas de los Lotes (Mismo origen, distinta pendiente)
# geom_line(data = df_pendientes,
#           aes(x = temp, y = res, color = metodo, group = lote_unico),
#           size = 0.7, alpha = 0.4) +
# Líneas de la MEDIA (
geom_line(data = df_medias_p,
aes(x = temp, y = res_media, group = metodo),
color = "black", size = 1.2) +
#scale_color_manual(values = c("Metodo 1" = "#E41A1C", "Metodo 2" = "#377EB8", "Metodo 3" = "#4DAF4A")) +
labs(
title = "Interacción Lote × Temperatura (sin intercepto)",
x = "Temperatura",
y = "Resistencia",
color = "Método"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5),
legend.position = "bottom"
)
# 1. Simulación de un solo método con interacción en la pendiente
set.seed(2026)
temp_cont <- seq(200, 275, length.out = 50)
n_lotes <- 3
df_delta <- expand.grid(
temp = temp_cont,
lote_id = 1:n_lotes
) %>%
mutate(
lote_unico = as.factor(paste("Lote", lote_id)),
beta_base = 0.20, # Pendiente media del método
# El Lote 2 tendrá una interacción marcada (delta positivo)
beta_lote = case_when(
lote_id == 1 ~ -0.08,
lote_id == 2 ~ 0.15,  # Este es nuestro delta notable
lote_id == 3 ~ -0.05
),
beta_final = beta_base + beta_lote,
res = 30 + (beta_final * (temp - 200))
)
# 2. Línea de la media teórica
df_media_unica <- data.frame(temp = temp_cont) %>%
mutate(res_media = 30 + (0.20 * (temp - 200)))
# 3. Gráfico con la anotación de Delta
ggplot() +
# Líneas de los lotes
geom_line(data = df_delta,
aes(x = temp, y = res, color = lote_unico, group = lote_unico),
size = 0.8, alpha = 0.5) +
# Línea de la MEDIA (Referencia)
geom_line(data = df_media_unica,
aes(x = temp, y = res_media),
color ="red2", size = 1.5) +
# ANOTACIÓN DE DELTA (Distancia al final del eje)
annotate("segment", x = 270, xend = 270,
y = 44, yend = 54.5, # Distancia entre media y Lote 2 al final
arrow = arrow(ends = "both", length = unit(0.2, "cm")),
color = "black", size = 1) +
annotate("text", x = 273, y = 49,
label = "delta[k]", parse = TRUE,
color = "black", size = 5) +
scale_color_manual(values = c("Lote 1" = "blue2", "Lote 2" = "blue2", "Lote 3" = "blue2")) +
labs(
title = "Efecto de Interacción Lote × Temperatura",
subtitle = "Delta representa la distancia de la pendiente del lote respecto a la media",
x = "Temperatura ()", y = "Resistencia", color = "Lote"
) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5))
load("papel.Rdata")
base$metodo=factor(base$metodo)
base$lote=factor(base$lote)
library(lattice)
xyplot(res~temp|lote,type=c("r","p"),xlab="temperatura",
ylab="resistencia",data=base)
apply(table(base$metodo, base$lote) > 0,1,sum)
xyplot(res~temp|metodo,groups=lote,type=c("r"),xlab="temperatura",
ylab="resistencia",layout=c(3,1),data=base)
xyplot(res~temp,groups=metodo,type=c("r"),xlab="temperatura",
ylab="resistencia",data=base,auto.key = T)
library(mvtnorm)
# Configuración de la matriz de gráficos (1 fila, 3 columnas)
par(mfrow = c(1, 3), mar = c(1, 1, 3, 1))
# Secuencia para los ejes X e Y
x <- seq(-3, 3, length = 50)
y <- seq(-3, 3, length = 50)
mu <- c(0, 0)
# Función para graficar la superficie según rho
graficar_persp <- function(rho, titulo) {
# Definir matriz de varianza-covarianza
sigma <- matrix(c(1, rho, rho, 1), ncol = 2)
# Calcular la densidad bivariada
z <- outer(x, y, function(x, y) dmvnorm(cbind(x, y), mean = mu, sigma = sigma))
# Generar el gráfico 3D
persp(x, y, z,
theta = 30, phi = 30, # Ángulos de visión
expand = 0.5,
col = "blue",
shade = 0.5,
ticktype = "detailed",
main = titulo,
zlab = "f(x,y)",
cex.main = 1.5)
}
# 1. Independencia: rho = 0
graficar_persp(0, expression(rho == 0))
# 2. Correlación Media: rho = 0.5
graficar_persp(0.5, expression(rho == 0.5))
# 3. Dependencia Fuerte: rho = 0.99
# Nota: Usamos 0.99 porque 1 hace que la matriz sea singular y persp falle
graficar_persp(0.99, expression(rho == 0.99))
# Restaurar configuración original de par
par(mfrow = c(1, 1))
beta0=beta1=c()
for(i in 1:9) { # Ojo que son 9 lotes
mod=lm(res~temp,base[base$lote==i,]) #Los lotes está enumerado del 1 al 9
beta0[i]=mod$coef[1]
beta1[i]=mod$coef[2]
}
plot(beta1,beta0,pch=18,col=4)
abline(lm(beta0~beta1))
cor(beta0,beta1)
library(lme4)
mod1=lmer(res~1+metodo*temp+(1+temp|lote),data=base)
mod2=lmer(res~1+metodo*temp+(1|lote)+(0+temp|lote),data=base)
# Se puede colocar 0 o -1, par ignorar el intercepto
anova(mod1,mod2,test="LRT")
mod2=lmer(res~1+metodo*temp+(1|lote)+(0+temp|lote),data=base)
mod3=lmer(res~metodo*temp+(1|lote),base)
anova(mod2,mod3)
drop1(mod3,test="Chisq")
mod4=lmer(res~metodo+temp+(1|lote),base)
drop1(mod4,test="Chisq")
fixef(mod4)
confint(mod4)[6,]*25
library(emmeans)
emmeans(mod4,pairwise~metodo,adjust="bonferroni")$contrast
load("riqueza.Rdata")
base$riq = apply(base[, 2:76] > 0,1,sum)# Se suma por fila, para contar el número de especies
xyplot(riq~NAP|playa,pch=18,
ylab="riqueza promedio",type=c("p","r"),data=base)
# mod1 es con \rho = 0
mod1=lmer(riq~1+NAP+(1+NAP|playa),data=base) # 1+NAP|playa, pendiente e intercepto de cada playa
# mod2 es con \rho \diff = 0
mod2=lmer(riq~1+NAP+(1|playa)+(0+NAP|playa),data=base)
anova(mod1,mod2,test="LRT")
drop1(mod1, test = "Chisq")#Recuerde que beta1 es fijo
fixef(mod1)[2]
confint(mod1)
summary(mod1)
log2(2)
exp(0.3)
